[sub_resource type="Shader" id="Shader_dpad"]
code = "shader_type canvas_item;

// true: show only the red part (pressed direction)
// false: show the whole cross with the red part painted white (neutral cross)
uniform bool only_highlight = false;

// In fragment(), COLOR already contains the texture color, so keep the
// vertex color (modulate) separately and use it instead.
varying vec4 vertex_color;

void vertex() {
	vertex_color = COLOR;
}

void fragment() {
	vec4 c = texture(TEXTURE, UV);
	bool red = c.r > 0.6 && c.g < 0.45 && c.b < 0.6;
	if (only_highlight) {
		if (!red) discard;
	} else if (red) {
		c.rgb = vec3(0.9);
	}
	COLOR = c * vertex_color;
}
"

[sub_resource type="ShaderMaterial" id="Material_base"]
shader = SubResource("Shader_dpad")
shader_parameter/only_highlight = false

[sub_resource type="ShaderMaterial" id="Material_highlight"]
shader = SubResource("Shader_dpad")
shader_parameter/only_highlight = true

